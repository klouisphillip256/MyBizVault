{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": { "root": "apps/web/", "framework": "vite", "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }] },
    "backend": { "root": "services/api/", "entrypoint": "app.main:app", "buildCommand": "python build.py" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
