DATABASE_URL=sqlite:///./mybizvault.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# Local prototype only. Displays the code to anyone holding a review link.
DEVELOPMENT_VERIFICATION=false
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./vault_objects
# For a private S3-compatible bucket, set STORAGE_BACKEND=s3 and:
# S3_BUCKET=my-private-bucket
# S3_ENDPOINT_URL=https://provider.example
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Optional message delivery. No outbound messages are sent unless a business user
# explicitly chooses a send action. Keep credentials in environment secrets.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM=MyBizVault <no-reply@example.com>
# SMS_WEBHOOK_URL=https://sms-provider.example/send
# SMS_WEBHOOK_TOKEN=...
