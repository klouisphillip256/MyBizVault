DATABASE_URL=sqlite:///./mybizvault.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# Local prototype only. Displays the code to anyone holding a review link.
DEVELOPMENT_VERIFICATION=false
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./vault_objects
# For a private S3-compatible bucket, set STORAGE_BACKEND=s3 and:
# S3_BUCKET=my-private-bucket
# S3_ENDPOINT_URL=https://provider.example
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Optional message delivery. No outbound messages are sent unless a business user
# explicitly chooses a send action. Keep credentials in environment secrets.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM=MyBizVault <no-reply@example.com>
# SMS_WEBHOOK_URL=https://sms-provider.example/send
# SMS_WEBHOOK_TOKEN=...
# Phase 7 provider integrations (configure secrets on the API service only):
# BREVO_API_KEY=...
# BREVO_SENDER_EMAIL=verified-sender@example.com
# BREVO_SENDER_NAME=MyBizVault
# BREVO_WEBHOOK_TOKEN=long-random-secret
# AT_API_KEY=...
# AT_USERNAME=sandbox
# AT_SANDBOX=true
# AT_WEBHOOK_TOKEN=long-random-secret
# USSD_CALLBACK_TOKEN=long-random-secret
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_TEST_MODE=true
# META_APP_SECRET=...
# META_VERIFY_TOKEN=long-random-secret
# For Vercel use a Neon PostgreSQL URL, STORAGE_BACKEND=database,
# COOKIE_SECURE=true, FRONTEND_ORIGIN=https://your-vercel-domain,
# and DEVELOPMENT_VERIFICATION=false.
